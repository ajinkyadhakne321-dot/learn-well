# ==============================================================
# AI ENGINEERING TUTOR - ENVIRONMENT CONFIGURATION
# ==============================================================
# Host and Server Configuration
HOST=127.0.0.1
PORT=8000
DEBUG=false

# Ollama Local Language Model Runtime
# Recommended models:
#   - llama3.2:3b (Fast, excellent balance for 8GB-16GB machines)
#   - qwen2.5-coder:7b (Outstanding for programming and mathematics)
#   - phi3:mini (Compact, fast reasoning)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_TIMEOUT_SECONDS=120

# Local Embeddings & Retrieval
# Recommended sentence transformer: all-MiniLM-L6-v2 (120MB, 384 dimensions)
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu
TOP_K_RETRIEVAL=4
CHUNK_SIZE=600
CHUNK_OVERLAP=100

# File Upload & Security Limits
MAX_UPLOAD_SIZE_MB=25
ALLOWED_EXTENSIONS=["pdf","txt","md"]

# Local Storage Paths
DATA_DIR=data
UPLOADS_DIR=data/uploads
PROCESSED_DIR=data/processed
INDEXES_DIR=data/indexes
DATABASE_PATH=data/database/tutor_metadata.json
AUDIO_DIR=data/audio

# Voice & Speech Services
# TTS_ENGINE options: "native" (uses macOS built-in 'say' command), "system", "disabled"
TTS_ENGINE=native
TTS_VOICE=Samantha
# STT_ENGINE options: "whisper", "web", "disabled"
STT_ENGINE=whisper
WHISPER_MODEL_SIZE=tiny
